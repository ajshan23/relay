# Local development only. Copy to .env
DATABASE_URL=postgres://relay:relay@localhost:5544/relay
REDIS_URL=redis://localhost:6390
API_PORT=3201
# Live update streams (/api/events) run as their own process
REALTIME_PORT=3203
WEB_URL=http://localhost:3200
NEXT_PUBLIC_API_URL=http://localhost:3201
# The public website (relay-site repo), for the Terms and Privacy links.
NEXT_PUBLIC_SITE_URL=http://localhost:3300
# Signs sessions. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Google sign-in (optional; leave both empty to hide the button).
# In Google Cloud, add the redirect URI ${WEB_URL}/api/auth/callback/google, e.g.
# http://localhost:3200/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Where the web app proxies /api requests to (and /api/events, the live streams)
API_URL=http://localhost:3201
REALTIME_URL=http://localhost:3203
# Local-only test account for end-to-end checks (set your own values)
DEV_TEST_EMAIL=owner@lumen.test
DEV_TEST_PASSWORD=

# Email (Resend). Without a key, emails are printed to the API log instead of sent.
# EMAIL_FROM must use a domain verified in Resend; onboarding@resend.dev only delivers to your own Resend email.
RESEND_API_KEY=
EMAIL_FROM="Relay <onboarding@resend.dev>"
EMAIL_REPLY_TO=

# Meta (WhatsApp, Instagram, Messenger)
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v26.0
# 32 bytes base64 (openssl rand -base64 32); encrypts channel tokens in the database
CHANNEL_SECRET_KEY=
MEDIA_DIR=.data/media

# File storage (customer media, uploads, imports, exports). With S3_BUCKET set, files go to S3;
# without it, to the local folder MEDIA_DIR. Set the bucket up once: pnpm --filter @relay/worker s3:setup
# Move files already on disk: pnpm --filter @relay/worker media:migrate
S3_BUCKET=
S3_REGION=ap-south-1
# For an S3-compatible service instead of AWS (Neon storage, Cloudflare R2, MinIO): its address.
# AWS_ENDPOINT_URL_S3 and AWS_REGION (as Neon's console gives them) work too. Check with:
# pnpm --filter @relay/worker storage:check
# S3_ENDPOINT=https://<project>.storage.neon.tech
# STORAGE_DRIVER=local   # force the local disk even when S3_BUCKET is set
# AWS keys of an IAM user that can only use this bucket (never commit real values).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

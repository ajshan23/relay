{
  "name": "@relay/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "tsx --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "dev:channel": "tsx --env-file=../../.env scripts/dev-channel.ts",
    "simulate": "tsx --env-file=../../.env scripts/simulate-meta-webhook.ts",
    "replay": "tsx --env-file=../../.env scripts/replay-webhooks.ts",
    "fake-graph": "tsx --env-file=../../.env scripts/fake-graph.ts",
    "s3:setup": "tsx --env-file=../../.env src/scripts/s3-setup.ts",
    "media:migrate": "tsx --env-file=../../.env src/scripts/migrate-media.ts",
    "previews:backfill": "tsx --env-file=../../.env src/scripts/backfill-previews.ts",
    "storage:check": "tsx --env-file=../../.env src/scripts/check-storage.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@hono/node-server": "^2.1.7",
    "@relay/agent": "workspace:*",
    "@relay/channels": "workspace:*",
    "@relay/core": "workspace:*",
    "@relay/db": "workspace:*",
    "@relay/email": "workspace:*",
    "@relay/kairos": "workspace:*",
    "bullmq": "^6.7.5",
    "hono": "^4.13.18",
    "ioredis": "^6.0.0",
    "mammoth": "1.13.0",
    "sharp": "0.35.5",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "^4.6.7"
  }
}

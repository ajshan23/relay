{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "!**/.next",
      "!**/node_modules",
      "!**/migrations",
      "!apps/web/src/components/ui",
      "!apps/lab/src/components/ui",
      "!apps/web/public",
      "!packages/ui/src/ui"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "linter": {
    "rules": {
      "recommended": true,
      "a11y": {
        "noLabelWithoutControl": {
          "level": "error",
          "options": { "inputComponents": ["Checkbox", "Switch"] }
        }
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
